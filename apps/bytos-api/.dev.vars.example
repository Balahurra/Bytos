# Local-only Worker secrets. Copy to `.dev.vars` and fill in.
# The Supabase anon key is public by design; the service-role key is NOT used here.
SUPABASE_URL=https://qetnpmgyseccwbpsjxcl.supabase.co
SUPABASE_ANON_KEY=
HANDOFF_ENCRYPTION_KEY=
