evals/smoke-tests/results/

.tui-test
secrets.json
tui-traces
tests/**/cache

# Backup created by scripts/marketplace-readme.mjs while publishing.
# Should never be committed: only exists if a publish aborts mid-swap.
.README.github.bak

# Tauri generated code
apps/*/src-tauri/gen
apps/*/src-tauri/bin
apps/examples/*/src-tauri/gen
apps/examples/*/src-tauri/bin
# Tauri UI test snapshots
apps/*/src/tests/.tui-test
apps/*/src/tests/tui-traces
apps/vscode/webview-ui/src/**/*.js
apps/vscode/webview-ui/src/**/*.js.map


# SDK Session files / User data
.bytos/data
.bytos/tmp
*.db
*.db-shm
*.db-wal
.bytos/**/managed.json
.bytos/**/bundle.json
apps/vscode/tsconfig.test.generated.json
.next/dev/static
**/src-tauri/target/debug/.fingerprint
apps/examples/desktop-app/src-tauri/target
apps/examples/desktop-app/src-tauri/dmg/background.gen.tiff
apps/examples/desktop-app/webview/.next

# Next.js generated type shim (churns between dev and build)
apps/examples/desktop-app/webview/next-env.d.ts
apps/examples/desktop-app/.cursor/settings.json

# Built webview assets (regenerated by bun run build:webview)
apps/vscode/webview-ui/build/

# Packaged extensions and their signatures. These are build artifacts that must
# never be committed: they are large and they embed a snapshot of the source
# tree at package time.
*.vsix
*.sig

# Voice (F1/F2) local artifacts. The pinned whisper.cpp engine + models are
# acquired per machine, are excluded from any packaged build, and total ~230 MB.
# They are reproduced with apps/vscode/scripts/voice-f2-fetch-assets.ps1, which
# verifies exact SHA-256s.
apps/vscode/assets/voice/bin/**
# ...except the Windows x64 capture helper, which is a release artifact: the
# packaged extension must contain it or Settings → Voice cannot find a
# microphone on an installed machine. Rebuild it with
# apps/vscode/scripts/build-voice-helper.ps1.
!apps/vscode/assets/voice/bin/win32-x64/
!apps/vscode/assets/voice/bin/win32-x64/bv-os-audio-helper.exe
apps/vscode/test-assets/

# Editor, agent, and review-tool scratch state
.agents/
.claude/
.codex/
.greptile/
.kanban/
# .worktreeinclude is product input: apps/vscode/src/utils/worktree-include.ts
# reads it, so it must stay tracked. Do not ignore it.

# Repository-local audit and implementation reports produced during a review.
# These are working documents, not product source. Release readiness documents
# live in docs/release-audit/ and are tracked.
*-AUDIT.md
*-REPORT.md
POST-AUDIT-IMPLEMENTATION-PLAN.md
RELEASE-BLOCKERS.md
REMAINING-ISSUES.md

# ...but the release-audit records themselves are part of the release.
!docs/release-audit/**
!docs/release-audit/*.md