# Default
.vscode/**
.vscode-test/**
.worktrees/**
# Agent tooling, never shipped in the VSIX
.agents/**
# Local temporary/debug files, never shipped in the VSIX
tmp/**
.claude/**
.bytos/**
.codex/**
CLAUDE.local.md
out/
dist-standalone/
node_modules/
# Nested workspace-member node_modules (bun links these under each package).
# Scoped to the sub-package dirs so it doesn't shadow the top-level
# node_modules/@vscode/codicons re-include below.
webview-ui/node_modules/**
testing-platform/node_modules/**
standalone/**/node_modules/**
src/**
standalone/**
# Build/dev tooling and inputs â€” bundled into dist/extension.js, not needed in the VSIX.
bunfig.toml
esbuild.mjs
knip.json
biome.jsonc
test-setup.js
.env.example
scripts/**
proto/**
testing-platform/**
tests/**
.gitignore
.yarnrc
esbuild.js
vsc-extension-quickstart.md
tsconfig*.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.vscode-test.*
eslint-rules/**
.github/**
.husky/**
.env

# sdk (separate monorepo with its own build/release pipeline)
sdk/**

# Source-of-truth for the marketplace README (the .vsix only ever sees the
# README.md that scripts/marketplace-readme.mjs swaps into place). The backup
# only exists if a publish aborts mid-swap; neither should ship in the .vsix.
README.marketplace.md
.README.github.bak
package.json.backup

# Custom
**/demo.gif
.nvmrc
.gitattributes
.prettierignore
.husky/
.github/
eslint-rules/
old_docs/
evals/
.codespellrc
buf.yaml
.bytosrules/

# Voice F1: the native C++ source and its build inputs stay development-only.
# The compiled Windows capture helper DOES ship: without it Settings → Voice
# cannot enumerate (or record from) a microphone on an installed machine.
native/**
assets/voice/README.md

# Voice F2: the pinned whisper engine ships from `assets/voice/whisper` (included
# by default). The downloaded models, the speech corpus and the duplicate engine
# under `test-assets/` are development/test assets only and must not be packaged.
test-assets/**

# Build metadata that is not read at runtime. The walkthrough, README, NOTICE,
# LICENSE, THIRD-PARTY-NOTICES.txt and PRIVACY.md are intentionally packaged;
# everything else here is generated or development-only.
.env.example
.gitleaks.toml
biome.json
vitest.config.ts
playwright.config.ts
knip.json
tsconfig*.json
skills-lock.json
e2e-build.mjs
test-results/
coverage/**
webview-ui/coverage/**
webview-ui/.vite-port

# Ignore all webview-ui files except the build directory (https://github.com/microsoft/vscode-webview-ui-toolkit-samples/blob/main/frameworks/hello-world-react-cra/.vscodeignore)
webview-ui/src/**
webview-ui/public/**
# webview-ui/index.html is the Vite dev-server template. The extension loads
# webview-ui/build/index.html at runtime; the root copy is never read, and one
# of the two copies is required in the VSIX.
**/webview-ui/index.html
webview-ui/README.md
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/components.json
webview-ui/tailwind.config.mjs
webview-ui/tsconfig*.json
webview-ui/vitest.config.*
webview-ui/.storybook/**
webview-ui/node_modules/**
**/.gitignore

# Webview chunks that are never loaded at runtime. Vite emits this live HMR
# helper during `bun run dev:webview`; the production webview never imports it.
webview-ui/build/assets/live.js
webview-ui/build/assets/live.js.map


# Source maps are already excluded by **/*.map above; this also covers maps
# that end up flattened inside the webview build.
webview-ui/build/**/*.map

# Ignore docs
docs/**
old_docs/**

# Fix issue where codicons don't get packaged (https://github.com/microsoft/vscode-extension-samples/issues/692)
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf

# Include default themes JSON files used in getTheme
!src/integrations/theme/default-themes/**

# Include icons
!assets/icons/**

# Ignore E2E build files
e2e-build.mjs
test-results/
coverage/**
webview-ui/coverage/**
webview-ui/.vite-port

# Ignore Storybook files
**/*.stories.tsx
*storybook.log
storybook-static
**/StorybookDecorator.tsx
