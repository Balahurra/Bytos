# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_USERINFO_URL=http://127.0.0.1:54321/auth/v1/user
# Production only (do not put a service-role key in a local browser build):
