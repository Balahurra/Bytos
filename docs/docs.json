{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Bytos",
	"description": "Open-source, BYOK autonomous AI coding agent for Visual Studio Code",
	"colors": {
		"primary": "#4F8CFF",
		"light": "#E8F1FF",
		"dark": "#05070D"
	},
	"logo": {
		"light": "/assets/bytos-wordmark-black.svg",
		"dark": "/assets/bytos-wordmark-white.svg",
		"href": "https://bytos.dev/"
	},
	"favicon": {
		"light": "/assets/bytos-icon-dark.svg",
		"dark": "/assets/bytos-icon-white.svg"
	},
	"background": {
		"color": {
			"light": "#fafaf9",
			"dark": "#070B14"
		}
	},
	"styling": {
		"eyebrows": "breadcrumbs",
		"codeblocks": "system",
		"css": "styles.css"
	},
	"appearance": {
		"default": "system",
		"strict": false
	},
	"fonts": {
		"family": "Geist Sans"
	},
	"navbar": {
		"links": [
			{
				"label": "GitHub",
				"icon": "github",
				"href": "https://github.com/Balahurra/Bytos"
			},
			{
				"label": "Discord",
				"icon": "discord",
				"href": "https://discord.gg/2hSFZY9Bs"
			},
			{
				"label": "YouTube",
				"icon": "youtube",
				"href": "https://www.youtube.com/@BytosAgent"
			},
			{
				"label": "X",
				"icon": "x",
				"href": "https://x.com/balahurra_bytos"
			}
		],
		"primary": {
			"type": "button",
			"label": "Install from Marketplace",
			"href": "https://marketplace.visualstudio.com/items?itemName=Bytos.bytos"
		}
	},
	"navigation": {
		"tabs": [
			{
				"tab": "Bytos",
				"icon": "robot",
				"groups": [
					{
						"group": "Getting started",
						"pages": [
							"bytos-overview",
							"getting-started/installing-bytos",
							"getting-started/quick-start",
							"getting-started/config"
						]
					},
					{
						"group": "Auto Phase Plan",
						"pages": [
							"features/auto-phase-plan"
						]
					},
					{
						"group": "Core workflows",
						"pages": [
							"core-workflows/plan-and-act",
							"core-workflows/working-with-files",
							"core-workflows/using-commands",
							"core-workflows/task-management",
							"core-workflows/checkpoints"
						]
					},
					{
						"group": "Features",
						"pages": [
							"features/auto-approve",
							"features/auto-compact",
							"features/jupyter-notebooks",
							"features/multiroot-workspace"
						]
					},
					{
						"group": "Customization",
						"pages": [
							"customization/bytos-rules",
							"customization/skills",
							"customization/hooks",
							"customization/bytosignore"
						]
					},
					{
						"group": "MCP and tools",
						"pages": [
							"mcp/mcp-overview",
							"tools-reference/all-bytos-tools"
						]
					},
					{
						"group": "Providers and models",
						"pages": [
							"provider-config/overview",
							"running-models-locally/overview",
							"provider-config/openrouter",
							"provider-config/anthropic",
							"provider-config/openai",
							"provider-config/google-gemini",
							"provider-config/openai-compatible",
							"provider-config/aws-bedrock/api-key",
							"provider-config/other-30-plus-providers"
						]
					},
					{
						"group": "Best practices",
						"pages": [
							"best-practices/memory-bank"
						]
					},
					{
						"group": "Troubleshooting",
						"pages": [
							"troubleshooting/faq",
							"troubleshooting/voice-and-microphone",
							"troubleshooting/networking-and-proxies"
						]
					},
					{
						"group": "Project",
						"pages": [
							"status-and-roadmap"
						]
					}
				]
			}
		]
	},
	"footer": {
		"socials": {
			"github": "https://github.com/Balahurra/Bytos",
			"website": "https://bytos.dev/",
			"discord": "https://discord.gg/2hSFZY9Bs",
			"youtube": "https://www.youtube.com/@BytosAgent",
			"x": "https://x.com/balahurra_bytos"
		}
	},
	"redirects": [
		{ "source": "/api", "destination": "/status-and-roadmap" },
		{ "source": "/cli", "destination": "/status-and-roadmap" },
		{ "source": "/desktop", "destination": "/status-and-roadmap" },
		{ "source": "/sdk", "destination": "/status-and-roadmap" },
		{ "source": "/kanban", "destination": "/status-and-roadmap" },
		{ "source": "/enterprise-solutions", "destination": "/status-and-roadmap" },
		{ "source": "/getting-started/bytos-provider", "destination": "/status-and-roadmap" },
		{ "source": "/getting-started/bytospass", "destination": "/status-and-roadmap" },
		{ "source": "/getting-started/free-models", "destination": "/status-and-roadmap" },
		{ "source": "/getting-started/authorizing-with-bytos", "destination": "/provider-config/overview" },
		{ "source": "/usage/cli-overview", "destination": "/status-and-roadmap" },
		{ "source": "/usage/bytos-desktop", "destination": "/status-and-roadmap" },
		{ "source": "/usage/kanban", "destination": "/status-and-roadmap" },
		{ "source": "/usage/tui", "destination": "/status-and-roadmap" },
		{ "source": "/usage/acp", "destination": "/status-and-roadmap" },
		{ "source": "/usage/cloud-agents", "destination": "/status-and-roadmap" },
		{ "source": "/features/subagents", "destination": "/status-and-roadmap" },
		{ "source": "/customization/plugins", "destination": "/status-and-roadmap" }
	],
	"search": {
		"prompt": "Search Bytos documentation..."
	}
}
