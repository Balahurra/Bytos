				"../sdk/packages/core/src/*/index.ts"
			],
			"@bytos/core/telemetry": [
				"../sdk/packages/core/src/services/telemetry/index.ts"
			],
			"@bytos/llms": ["../sdk/packages/llms/src/index.ts"],
			"@bytos/shared": ["../sdk/packages/shared/src/index.ts"],
			"@bytos/shared/storage": ["../sdk/packages/shared/src/storage/index.ts"],
			"@bytos/shared/db": ["../sdk/packages/shared/src/db/index.ts"],
