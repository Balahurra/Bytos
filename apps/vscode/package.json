{
	"name": "bytos",
	"displayName": "Bytos",
	"description": "Bytos is an open-source autonomous AI coding agent for Visual Studio Code. It plans before it edits, asks before it acts, and can edit files, run commands, use the browser, and call MCP tools with your approval. Auto Phase Plan runs up to 10 sequential, automatic phases with per-phase provider, model, API key, and MCP settings - each phase its own task, with an overall Markdown report. Bring your own API key (BYOK); no Bytos account or backend is required.",
	"version": "1.0.2",
	"icon": "assets/icons/icon.png",
	"publisher": "bytos",
	"__metadata": {
		"publisherId": "bytos",
		"publisherDisplayName": "Bytos"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"author": {
		"name": "Bytos contributors"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Balahurra/Bytos"
	},
	"homepage": "https://bytos.dev/",
	"bugs": {
		"url": "https://github.com/Balahurra/Bytos/issues"
	},
	"galleryBanner": {
		"color": "#070B14",
		"theme": "dark"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"bytos",
		"ai",
		"ai-coding-agent",
		"ai-coding-assistant",
		"autonomous-agent",
		"autonomous-ai-agent",
		"autonomous-coding-agent",
		"automatic-coding-agent",
		"auto-phase",
		"auto-phase-coding-agent",
		"agentic-ai",
		"agentic-coding",
		"coding-assistant",
		"coding-agent",
		"developer-tools",
		"llm",
		"mcp",
		"model-context-protocol",
		"multi-phase",
		"multi-provider",
		"open-source",
		"sequential-agents",
		"vs-code",
		"vscode",
		"vscode-extension",
		"byok"
	],
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"walkthroughs": [
			{
				"id": "BytosWalkthrough",
				"title": "Meet Bytos, your new coding partner",
				"description": "Bytos codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell Bytos what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let Bytos Learn Your Codebase",
						"description": "Point Bytos to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Always Use the Best AI Models",
						"description": "Bytos empowers you with State-of-the-Art AI, connecting to top models (Anthropic, Gemini, OpenAI & more).",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, and other external tools through MCP.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review Bytos's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "bytos-ActivityBar",
					"title": "Bytos",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"bytos-ActivityBar": [
				{
					"type": "webview",
					"id": "bytos.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "bytos.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "bytos.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "bytos.marketplaceButtonClicked",
				"title": "Customize",
				"icon": "$(wrench)"
			},
			{
				"command": "bytos.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "bytos.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "bytos.openAccount",
				"title": "Account",
				"category": "Bytos",
				"icon": "$(person)"
			},
			{
				"command": "bytos.notificationsButtonClicked",
				"title": "Notifications",
				"category": "Bytos",
				"icon": "$(bell)"
			},
			{
				"command": "bytos.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "Bytos",
				"when": "bytos.isDevMode"
			},
			{
				"command": "bytos.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "Bytos",
				"when": "bytos.isDevMode"
			},
			{
				"command": "bytos.voice.f1.smoke",
				"title": "Voice F1: Run Capture Smoke Test",
				"category": "Bytos",
				"when": "bytos.isDevMode"
			},
			{
				"command": "bytos.addToChat",
				"title": "Add to Bytos",
				"category": "Bytos"
			},
			{
				"command": "bytos.addTerminalOutputToChat",
				"title": "Add to Bytos",
				"category": "Bytos"
			},
			{
				"command": "bytos.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "Bytos"
			},
			{
				"command": "bytos.generateGitCommitMessage",
				"title": "Generate Commit Message with Bytos",
				"category": "Bytos",
				"icon": {
					"light": "assets/icons/icon-light.svg",
					"dark": "assets/icons/icon-dark.svg"
				}
			},
			{
				"command": "bytos.abortGitCommitMessage",
				"title": "Generate Commit Message with Bytos - Stop",
				"category": "Bytos",
				"icon": "$(debug-stop)"
			},
			{
				"command": "bytos.explainCode",
				"title": "Explain with Bytos",
				"category": "Bytos"
			},
			{
				"command": "bytos.improveCode",
				"title": "Improve with Bytos",
				"category": "Bytos"
			},
			{
				"command": "bytos.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with Bytos",
				"category": "Bytos",
				"icon": "$(sparkle)"
			},
			{
				"command": "bytos.jupyterExplainCell",
				"title": "Explain Jupyter Cell with Bytos",
				"category": "Bytos",
				"icon": "$(question)"
			},
			{
				"command": "bytos.jupyterImproveCell",
				"title": "Improve Jupyter Cell with Bytos",
				"category": "Bytos",
				"icon": "$(lightbulb)"
			},
			{
				"command": "bytos.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "Bytos"
			}
		],
		"keybindings": [
			{
				"command": "bytos.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "bytos.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "bytos.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "bytos.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == bytos.SidebarProvider"
				},
				{
					"command": "bytos.marketplaceButtonClicked",
					"group": "navigation@2",
					"when": "view == bytos.SidebarProvider"
				},
				{
					"command": "bytos.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == bytos.SidebarProvider"
				},
				{
					"command": "bytos.openAccount",
					"group": "navigation@5",
					"when": "view == bytos.SidebarProvider"
				},
				{
					"command": "bytos.notificationsButtonClicked",
					"group": "navigation@6",
					"when": "view == bytos.SidebarProvider"
				},
				{
					"command": "bytos.settingsButtonClicked",
					"group": "navigation@7",
					"when": "view == bytos.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "bytos.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "bytos.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "bytos.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !bytos.isGeneratingCommit"
				},
				{
					"command": "bytos.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && bytos.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "bytos.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "bytos.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "bytos.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "bytos.generateGitCommitMessage",
					"when": "config.git.enabled && !bytos.isGeneratingCommit"
				},
				{
					"command": "bytos.abortGitCommitMessage",
					"when": "config.git.enabled && bytos.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "Bytos",
			"properties": {}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "bun run check-types && bun run lint && bun esbuild.mjs",
		"compile-standalone": "bun run check-types && bun run lint && bun esbuild.mjs --standalone",
		"postcompile-standalone": "node scripts/package-standalone.mjs",
		"dev": "bun run protos && bun run watch",
		"watch": "bun run --parallel watch:esbuild watch:tsc",
		"watch:esbuild": "bun esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run check-types && bun run lint && bun run build:production && bun run licenses:generate && bun run licenses:check",
		"licenses:generate": "node scripts/generate-third-party-notices.mjs",
		"licenses:check": "node scripts/check-licenses.mjs",
		"licenses:check:vsix": "node scripts/check-licenses.mjs --require-vsix",
		"build:production": "bun run build:webview && bun esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "bun run clean:build && bun run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "bun run protos && bunx tsc --noEmit && bun run check-types:compat && cd webview-ui && bunx tsc --noEmit",
		"check-types:compat": "bunx tsc --project tsconfig.vscode-compat.json --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && bun run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"analyze:unused": "bunx --yes knip --config knip.json --include files,exports,types,enumMembers,duplicates",
		"analyze:unused:prod": "bunx --yes knip --config knip.json --production --include files,exports,types,enumMembers,dependencies",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error --semicolons=as-needed",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write --semicolons=as-needed",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe --semicolons=as-needed",
		"ci:check-all": "bun run --parallel check-types lint format",
		"ci:build": "bun run protos && bun run build:webview && bun esbuild.mjs && bun run compile-tests",
		"pretest": "bun run compile && bun run compile-tests && bun run compile-standalone && bun run lint",
		"test": "bun run test:unit && bun run test:integration",
		"test:integration": "bun run compile-tests && vscode-test",
		"test:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:vitest": "vitest run --config vitest.config.ts",
		"test:cloud": "vitest run --config vitest.cloud.config.ts",
		"test:vitest:watch": "vitest --config vitest.config.ts",
		"test:bun": "bun scripts/run-bun-tests.ts",
		"test:bun:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:coverage": "bun run compile-tests && vscode-test --coverage",
		"test:sca-server": "bun --watch scripts/test-standalone-core-api-server.ts",
		"test:tp-orchestrator": "bun scripts/testing-platform-orchestrator.ts",
		"dev:mcp-oauth-test-server": "bun src/dev/mcp-oauth-test-server/server.ts",
		"dev:cloud-sessions": "bun src/dev/local-cloud-server.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e": "bun run build:production && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "bun scripts/interactive-playwright.ts",
		"install:all": "bun install",
		"dev:webview": "node scripts/clean-webview-vite-cache.mjs && cd webview-ui && bun run dev",
		"build:webview": "bun run protos && cd webview-ui && bun run build",
		"test:webview": "cd webview-ui && bun run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"docs": "cd docs && bun run dev",
		"docs:check-links": "cd docs && bun run check",
		"docs:rename-file": "cd docs && bun run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && bun run storybook",
		"eval:smoke:run": "bun evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add apps/vscode/proto/bytos/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true --semicolons=as-needed"
		]
	},
