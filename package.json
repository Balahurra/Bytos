{
    "name": "@bytos/packages",
    "private": true,
    "description": "Bytos - the open-source autonomous AI coding agent for Visual Studio Code.",
    "license": "Apache-2.0",
    "homepage": "https://bytos.dev/",
    "repository": {
        "type": "git",
        "url": "https://github.com/Balahurra/Bytos"
    },
    "workspaces": [
        "sdk/packages/*",
        "apps/*",
        "apps/vscode/webview-ui",
        "apps/vscode/testing-platform",
        "apps/bytos-hub/src/webview",
        "apps/examples/*",
        "apps/examples/vscode/src/webview",
        "sdk/examples",
        "sdk/examples/plugins/*"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "bun run clean && bun install && bun run build:sdk && bun -F @bytos/cli build",
        "build:sdk": "bun --production -F './sdk/packages/*' build && bun sdk/packages/core/build-plugin-runtime.mts",
        "build:apps": "bun -F './apps/**' --production build",
        "build:models": "bun -F @bytos/llms generate:models && bun format --write",
        "dev": "bun --conditions=development run build:sdk && bun run cli && bun run cli hub stop",
        "cli": "bun --conditions=development --cwd apps/cli dev",
        "code": "bun --conditions=development -F @bytos/code dev",
        "clean": "bun run sdk/scripts/clean.ts",
        "types": "bun --parallel -F '*' typecheck",
        "test": "bun --parallel -F './sdk/packages/**' -F @bytos/cli -F @bytos/bytos-hub -F @bytos/vscode test",
        "test:unit": "bash -lc 'set -euo pipefail; bun -F @bytos/agents test & p1=$!; bun -F @bytos/llms test & p2=$!; bun -F @bytos/core test:unit & p3=$!; bun -F @bytos/cli test:unit & p4=$!; bun -F @bytos/bytos-hub test & p5=$!; bun -F @bytos/vscode test & p6=$!; wait $p1; wait $p2; wait $p3; wait $p4; wait $p5; wait $p6'",
        "test:e2e": "bun -F @bytos/core test:e2e && bun -F @bytos/cli test:e2e",
        "test:e2e:interactive": "bun -F @bytos/cli test:e2e:interactive",
        "verify:routines": "zsh -lc 'cd sdk/packages/core && bunx vitest run src/cron/schedule-service.test.ts --config vitest.config.ts'",
        "verify:workos-device-auth": "bun sdk/scripts/verify-workos-device-auth.ts",
        "biome": "bunx --bun @biomejs/biome",
        "format": "bun biome format sdk/ apps/cli/ apps/bytos-hub/ apps/examples/",
        "lint": "bun biome lint sdk/ apps/cli/ apps/bytos-hub/ apps/examples/",
        "fix": "bun biome check --write --unsafe --diagnostic-level=error sdk/ apps/cli/ apps/bytos-hub/ apps/examples/",
        "check": "bun biome check --diagnostic-level=error sdk/ apps/cli/ apps/bytos-hub/ apps/examples/ && bun run build:sdk && bun run -F @bytos/cli build && bun -F @bytos/bytos-hub build:webview && bun --parallel -F './sdk/packages/**' -F @bytos/cli -F @bytos/bytos-hub typecheck && bun sdk/scripts/check-publish.ts",
        "version": "bun run types && bun sdk/scripts/version.ts",
        "release": "bun sdk/scripts/release.ts",
        "security:audit": "bun audit --audit-level=high && npm audit --prefix docs && npm audit --prefix evals/analysis && npm audit --prefix evals && npm audit --prefix apps/vscode/standalone/runtime-files",
        "security:vsix": "node scripts/security/check-vsix.mjs",
        "security:gate": "node scripts/security/release-gate.mjs"
    },
    "lint-staged": {
        "sdk/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ],
        "apps/{cli,bytos-hub,examples}/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "module": "index.ts",
    "type": "module",
    "engines": {
        "bun": "1.4.2",
        "node": ">=22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.5",
        "@types/bun": "^1.4.2",
        "@types/node": "^25.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "vitest": "^4.1.12"
    },
    "peerDependencies": {
        "nanoid": "^5.1.7",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "axios": "1.20.0",
        "proxy-addr": ">=2.0.8",
        "fast-uri": ">=4.2.3 <5",
        "undici": ">=7.30.1 <8",
        "@opentui/core": "0.4.3",
        "@opentui/react": "0.4.3",
        "tar-fs": ">=3.1.1",
        "tar": "^7.5.2",
        "js-yaml": ">=4.3.2 <5",
        "serialize-javascript": ">=7.1.4",
        "protobufjs": "7.6.5",
        "mermaid": "11.16.1",
        "diff": "8.0.4",
        "@jridgewell/trace-mapping": ">=0.3.31",
        "@sap-cloud-sdk/connectivity": "4.9.1",
        "@sap-cloud-sdk/http-client": "4.9.1",
        "@sap-cloud-sdk/openapi": "4.9.1",
        "@sap-cloud-sdk/resilience": "4.9.1",
        "@sap-cloud-sdk/util": "4.9.1",
        "@grpc/grpc-js": ">=1.14.7 <2",
        "@modelcontextprotocol/sdk": ">=1.32.2 <2",
        "zod": ">=4.6.7 <5",
        "image-size": ">=2.1.0 <3",
        "follow-redirects": ">=1.16.3 <2",
        "postcss": ">=8.5.32 <9",
        "postcss-selector-parser": ">=7.2.0 <8",
        "source-map-js": ">=1.2.2 <2",
        "qs": ">=6.17.1 <7",
        "linkify-it": ">=5.0.2 <6",
        "katex": ">=0.18.2 <0.19",
        "minimatch": ">=11.0.6 <12",
        "glob": ">=14.0.4 <15",
        "@hono/node-server": ">=2.1.6 <3",
        "@azure/identity": ">=4.14.1 <5",
        "@azure/msal-node": ">=7.1.0 <8",
        "@opentelemetry/core": ">=2.8.0 <3",
        "@opentelemetry/propagator-jaeger": ">=2.9.0 <3",
        "@opentelemetry/sdk-trace-node": ">=2.8.0 <3",
        "@opentelemetry/sdk-trace-base": ">=2.8.0 <3",
        "@opentelemetry/sdk-metrics": ">=2.8.0 <3",
        "@opentelemetry/resources": ">=2.8.0 <3",
        "@opentelemetry/sdk-logs": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-logs-otlp-grpc": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-logs-otlp-http": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-logs-otlp-proto": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-metrics-otlp-grpc": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-metrics-otlp-http": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-metrics-otlp-proto": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-trace-otlp-grpc": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-trace-otlp-http": ">=0.214.0 <0.215",
        "@opentelemetry/exporter-trace-otlp-proto": ">=0.214.0 <0.215",
        "tinypool": ">=2.1.2 <3",
        "vite": ">=8.3.7 <9",
        "vitest": ">=4.1.12 <5",
        "@vitest/mocker": ">=4.1.12 <5",
        "@vitest/coverage-v8": ">=4.1.12 <5",
        "storybook": ">=10.6.7 <11",
        "puppeteer-core": ">=25.17.0 <26",
        "puppeteer-chromium-resolver": ">=25.0.0 <26",
        "@puppeteer/browsers": ">=3.2.7 <4"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "grpc-tools"
    ],
    "packageManager": "bun@1.4.2",
    "patchedDependencies": {
        "@opentui-ui/dialog@0.1.2": "patches/@opentui-ui%2Fdialog@0.1.2.patch",
        "ollama-ai-provider-v2@4.0.1": "patches/ollama-ai-provider-v2@4.0.1.patch",
        "@shadcn/react@0.3.1": "patches/@shadcn%2Freact@0.3.1.patch",
        "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
}
